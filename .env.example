# URL pública de esta instalación. En Vercel usa el dominio final del fork.
# Si se omite, Vercel usa automáticamente el dominio de ese despliegue.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Tokens opcionales de propiedad para Google Search Console y Bing Webmaster Tools.
# Copia únicamente el valor del atributo content de cada metaetiqueta.
# GOOGLE_SITE_VERIFICATION="token-de-google"
# BING_SITE_VERIFICATION="token-de-bing"

# Activa los datos de demostración únicamente en el despliegue de preview.
# MISETUP_MODE="preview"

# Persistencia para una instalación propia.
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/misetup"
# EDITOR_PASSWORD="usa-una-clave-larga-y-unica"

# Descomenta solo si tu PostgreSQL local no utiliza SSL.
# POSTGRES_SSL="disable"
